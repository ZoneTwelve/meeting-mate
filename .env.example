# Guest display name (not a Google Account email or password).
MEET_USERNAME=Yumi

# Optional: a valid local Apple Development signing identity (security find-identity -p codesigning).
# A stable certificate preserves the recorder's identity across native rebuilds.
# MEETING_MATE_CODESIGN_IDENTITY=

# Slack /meeting integration uses a separate private .env.yumi.
# See docs/slack-binding.md; never commit Slack tokens or signing secrets.
